generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CommunityReport {
  id              String   @id @default(uuid())
  category        String   // pothole, waterlogging, streetlight, obstruction, cleanliness, other
  title           String
  description     String
  locationAddress String
  latitude        Float?
  longitude       Float?
  observationTime DateTime?
  status          String   @default("Pending verification") // "Pending verification", "Verified", "Resolved"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdAt])
}
